OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default cheap model (~$0.002/query). Set to anthropic/claude-sonnet-4-6 for max quality (~$0.017/query).
LLM_MODEL=anthropic/claude-haiku-4-5
CR_MODEL=anthropic/claude-haiku-4-5
CHROMA_PERSIST_DIR=./chroma
EMBEDDING_MODEL=BAAI/bge-m3
DEFAULT_TENANT=public
LOG_LEVEL=INFO

# Hybrid-retrieval tuning (see docs/eval-report.md). Tuned production config is
# dense-heavy 2:1 at top_k=5. Changing these needs no re-ingest.
VECTOR_WEIGHT=2.0
KEYWORD_WEIGHT=1.0
TOP_K=5

# Rendered PDF page-thumbnail dir. Default resolves to /app/data/pages in the
# container (WORKDIR=/app) and api/data/pages locally.
PAGES_DIR=./data/pages

# Admin upload UI — generate with: openssl rand -hex 32
ADMIN_TOKEN=
RAW_DIR=./data/raw

# /query rate-limit (per-IP, in-process). Set to 0 to disable either window.
RATE_LIMIT_PER_DAY=20
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_TRUST_FORWARDED=true

# Demo / cost guard. When true, /query still retrieves and returns real cited
# sources, but skips the paid OpenRouter generation call and returns a fixed
# notice (settings.demo_notice) as the answer. Keeps a public demo free to run.
QUERY_GENERATION_DISABLED=false

# Metrics SQLite — query log + eval-run history for the dashboard
METRICS_DB_PATH=./data/metrics/metrics.sqlite
